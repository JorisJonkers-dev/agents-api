#!/bin/sh
# git-credential-agents-api — speaks git's credential-helper protocol
# (see gitcredentials(7)) and answers `get` from this Workspace's
# per-directory unix socket at .agents-api/git-credentials.sock (#63).
# `store` and `erase` are silently accepted: nothing here holds
# credentials to persist, and git aborts the whole operation if a
# helper it invoked exits non-zero for those verbs.
#
# There is no environment variable naming the socket: run-as-agent
# clearenv()s before an Agent Session ever runs (ADR 0003), so anything
# this script needs has to be found from where git runs it — inside
# the repository, inside the Workspace directory. Walking up from $PWD
# to find .agents-api/git-credentials.sock always lands on the
# Workspace the calling repo actually lives in, which is the same
# scoping the socket server enforces from its own side (by which
# socket a connection arrived on, never anything the client sends).
#
# python3 does the actual socket round-trip: this image has no
# guaranteed `nc -U`, and `curl --unix-socket` speaks HTTP over the
# socket rather than this newline-JSON wire protocol (verified by
# hand: curl sends a full HTTP request line and chokes on the raw
# JSON reply with "Received HTTP/0.9 when not allowed").
set -eu

find_socket() {
    dir=$PWD
    while [ "$dir" != "/" ]; do
        candidate="$dir/.agents-api/git-credentials.sock"
        if [ -S "$candidate" ]; then
            printf '%s' "$candidate"
            return 0
        fi
        dir=$(dirname "$dir")
    done
    return 1
}

operation=${1:-}

# Only `get` returns anything; git requires `store`/`erase` to exit 0
# silently, and this helper never persists credentials of its own.
if [ "$operation" != "get" ]; then
    exit 0
fi

protocol=""
host=""
path=""
while IFS='=' read -r key value; do
    if [ -z "$key" ]; then
        break
    fi
    case "$key" in
        protocol) protocol=$value ;;
        host) host=$value ;;
        path) path=$value ;;
    esac
done

if [ -z "$protocol" ] || [ -z "$host" ]; then
    exit 0
fi

repo_url="$protocol://$host"
if [ -n "$path" ]; then
    repo_url="$repo_url/$path"
fi

socket_path=$(find_socket) || exit 0

# Any failure here — no socket, a denial, malformed JSON — means "I
# have no credentials": exit 0 printing nothing so git falls through
# instead of aborting on a non-zero helper exit.
token=$(GIT_CREDENTIAL_AGENTS_API_SOCKET="$socket_path" GIT_CREDENTIAL_AGENTS_API_REPO_URL="$repo_url" python3 <<'PYEOF' || true
import json
import os
import socket
import sys

sock_path = os.environ["GIT_CREDENTIAL_AGENTS_API_SOCKET"]
repo_url = os.environ["GIT_CREDENTIAL_AGENTS_API_REPO_URL"]

try:
    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(10)
    conn.connect(sock_path)
    conn.sendall((json.dumps({"repoUrl": repo_url}) + "\n").encode("utf-8"))
    conn.shutdown(socket.SHUT_WR)
    chunks = []
    while True:
        chunk = conn.recv(4096)
        if not chunk:
            break
        chunks.append(chunk)
    conn.close()
    reply = json.loads(b"".join(chunks).decode("utf-8"))
    token = reply.get("token")
    if isinstance(token, str) and token:
        sys.stdout.write(token)
except Exception:
    pass
PYEOF
)

if [ -z "$token" ]; then
    exit 0
fi

printf 'username=x-access-token\n'
printf 'password=%s\n' "$token"
